{
  "name": "dsh-quick-send",
  "version": "1.1.2",
  "description": "DSH 快捷发送插件：在输入框下方、上下文进度旁提供可自定义的快捷指令按钮，一键把预设文字直接发送到当前对话，省去重复打字；每条指令的名称、字号、透明度、模块化形状与发送内容均可就地编辑，右键按钮组可拖动换位置。修复上下文进度与累计使用区域被挤压后无法点击的问题。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "harness",
    "cordis",
    "web-ui",
    "ui",
    "composer",
    "shortcut",
    "quick-send",
    "productivity",
    "prompt",
    "input"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "PROVENANCE.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1250589385/DSH-Quick-Send.git"
  },
  "bugs": {
    "url": "https://github.com/1250589385/DSH-Quick-Send/issues"
  },
  "homepage": "https://github.com/1250589385/DSH-Quick-Send#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
